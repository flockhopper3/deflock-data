# Google Geocoding API key — optional. Used by scripts/02a_google_geocode.py to
# upgrade orgs the Census gazetteers could only place at a state centroid.
# Without it the step runs in cache-only mode (committed google_geocode_cache.json).
# Get one at https://console.cloud.google.com/apis/credentials
# Copy this file to eyesonflock/.env (gitignored).
GOOGLEMAPSAPI=your-key-here
